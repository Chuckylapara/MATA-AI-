# ---- Core ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Database / cache (docker-compose service names) ----
DATABASE_URL=postgresql+asyncpg://mata:mata@db:5432/mata
REDIS_URL=redis://redis:6379/0

# ---- Auth (CHANGE jwt_secret in production!) ----
JWT_SECRET=please-change-this-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- Seed admin ----
SEED_ADMIN_EMAIL=admin@mata.ai
SEED_ADMIN_PASSWORD=admin12345

# ---- Provider keys (leave blank to use built-in mock providers) ----
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
# NVIDIA NIM (build.nvidia.com) — primary LLM engine (chat + Studio scripts)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Groq Whisper — audio transcription for the Clips module (long video -> shorts)
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3
# Hugging Face Inference API — free image (FLUX) + music (MusicGen) models
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_MUSIC_MODEL=facebook/musicgen-small
REPLICATE_API_TOKEN=
# Premium voice (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# kie.ai — backup for images / AI video animation / Suno music (Viral AI Studio)
KIE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Models ----
CHAT_MODEL=claude-opus-4-8
CODE_MODEL=claude-opus-4-8
AGENT_MODEL=claude-opus-4-8

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================
# NEXUS (personal AI OS layer) — all optional. See docs/nexus/QUICKSTART.md
# ============================================================
NEXUS_SERVICE_URL=http://nexus:8014
# Local models via Ollama (free, private). e.g. http://localhost:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Force a provider per role (anthropic|openai|nvidia|groq|ollama|gemini|mock)
NEXUS_FAST_PROVIDER=
NEXUS_REASONING_PROVIDER=
NEXUS_VISION_PROVIDER=
NEXUS_EMBED_PROVIDER=
# Dev-only placeholder model when no provider is configured (replies are labelled [DEV MOCK])
NEXUS_ALLOW_DEV_MOCK=true
NEXUS_MAX_STEPS=6
NEXUS_SCHEDULER=1
# Web search providers (Wikipedia is always available, keyless)
SEARXNG_URL=
TAVILY_API_KEY=
BRAVE_API_KEY=
NEXUS_SEARCH_PROVIDERS=searxng,tavily,brave,wikipedia
